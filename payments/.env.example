# Solana RPC endpoint.
# Local test validator (default):
SOLANA_RPC_URL=http://localhost:8899
# Devnet alternative:
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Mint address printed by `npm run create-mock-usdc` (6 decimals, mock USDC).
MOCK_USDC_MINT=

# Cognilance platform treasury wallet (owner of the treasury token account).
TREASURY_WALLET=

# Keypair file for the backend authority signer (the only key allowed to call
# release_escrow / refund_escrow).
BACKEND_AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json

# Product payment layer (SDK / orchestrator) — mock ledger by default.
PAYMENTS_ENABLED=1
# PAYMENTS_DB_PATH=~/.cognilance/payments.db
# Do not enable until the Solana IDL client is wired (raises NotImplementedError):
# PAYMENTS_USE_CHAIN=1
