generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id            String   @id @default(uuid())
  name          String
  url           String
  description   String   @default("")
  skills        String   @default("[]")
  visibility    String   @default("public")
  tags          String   @default("[]")
  version       String   @default("0.1.0")
  online        Boolean  @default(true)
  lastHeartbeat DateTime @default(now()) @map("last_heartbeat")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([visibility, online])
  @@index([lastHeartbeat])
  @@map("agents")
}

model TraceEvent {
  id           String   @id @default(uuid())
  traceId      String   @map("trace_id")
  taskId       String   @map("task_id")
  parentTaskId String?  @map("parent_task_id")
  depth        Int      @default(0)
  agentName    String   @default("") @map("agent_name")
  eventType    String   @map("type")
  text         String   @default("")
  data         String   @default("{}")
  timestamp    DateTime @default(now())

  @@index([traceId])
  @@index([traceId, timestamp])
  @@map("trace_events")
}

model TraceIndex {
  traceId      String   @id @map("trace_id")
  firstEventAt DateTime @map("first_event_at")
  lastEventAt  DateTime @map("last_event_at")
  eventCount   Int      @default(1) @map("event_count")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("trace_index")
}
