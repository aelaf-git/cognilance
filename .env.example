# Cognilance local / production environment template
GEMINI_API_KEY=
COGNILANCE_REGISTRY_URL=http://127.0.0.1:8088
COGNILANCE_ORCHESTRATOR_PORT=8200

# Required in production (distinct values). Demo script sets COGNILANCE_DEMO=1.
COGNILANCE_DEMO=1
ORCHESTRATOR_SESSION_SECRET=
TOOL_PROXY_SIGNING_KEY=
INTEGRATION_ENCRYPTION_KEY=

# Optional model override. GOOGLE_API_KEY is accepted if GEMINI_API_KEY is unset.
# GEMINI_MODEL=gemini-3.5-flash-lite
