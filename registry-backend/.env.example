# PostgreSQL (Prisma uses postgresql://)
DATABASE_URL=postgresql://cognilance:cognilance@localhost:5433/cognilance

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Comma-separated raw API keys accepted without DB lookup (dev/bootstrap only)
BOOTSTRAP_API_KEYS=ck-your-dev-key-here

# Agents without heartbeat within this window are marked offline
HEARTBEAT_TIMEOUT_SECONDS=90
STALE_CHECK_INTERVAL_SECONDS=30

# CORS (comma-separated origins, or *)
CORS_ORIGINS=*
