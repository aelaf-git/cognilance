FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential \
  && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY sdk ./sdk
COPY core ./core
COPY tools ./tools
COPY pipelines ./pipelines
COPY agents ./agents
COPY api ./api
COPY workers ./workers
COPY evals ./evals

RUN pip install --no-cache-dir -e .

ENV COGNILANCE_DEMO=1 \
    COGNILANCE_COORDINATOR_HOST=0.0.0.0 \
    COGNILANCE_COORDINATOR_PORT=8200 \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

EXPOSE 8200

CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8200", "--reload"]
