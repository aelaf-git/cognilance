FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential \
  && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY SDK ./SDK
COPY tools ./tools
COPY pipeline ./pipeline
COPY agents/orchestrator ./agents/orchestrator

RUN pip install --no-cache-dir -e . -e ./tools -e ./pipeline -e ./agents/orchestrator

ENV COGNILANCE_DEMO=1 \
    COGNILANCE_ORCHESTRATOR_HOST=0.0.0.0 \
    COGNILANCE_ORCHESTRATOR_PORT=8200 \
    PYTHONUNBUFFERED=1

EXPOSE 8200

CMD ["uvicorn", "orchestrator.server:app", "--host", "0.0.0.0", "--port", "8200", "--reload"]
